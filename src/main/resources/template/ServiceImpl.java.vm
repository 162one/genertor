package ${package}.${moduleName}.service.impl;

import com.alibaba.fastjson.JSON;
import com.hd.common.util.PageBean;
import com.hd.common.util.PageParam;
import com.hd.common.util.list.ListUtil;
import lombok.extern.slf4j.Slf4j;
import com.hd.common.model.vo.CurrAccountVo;
import javax.annotation.Resource;
import org.springframework.stereotype.Service;
import java.util.List;

import ${package}.${moduleName}.mapper.${className}Mapper;
import ${package}.${moduleName}.model.po.${className}Po;
import ${package}.${moduleName}.service.${className}Service;

/**
 * ${comments}
 *
 * &#064;author ${author}
 * &#064;date ${datetime}
 */
@Service
@Slf4j
public class ${className}ServiceImpl implements ${className}Service {

    @Resource
    private ${className}Mapper ${classname}Mapper;

    /**
     * ${comments}列表信息
     *
     * @param pageParam
     * @return 结果
     */
    @Override
    public PageBean<${className}Po> page(PageParam pageParam) {

        log.info("${className}FacadeImpl.page:入参：pageParam:{}", JSON.toJSON(pageParam));
        pageParam.startPage();
        List<${className}Po> ${classname}List = ${classname}Mapper.page();
        PageBean<${className}Po> ${classname}PageBean = new PageBean<>(${classname}List);
        return ${classname}PageBean;
    }

    /**
     * ${comments}详细信息
     *
     * @param ${pk.attrname} ${comments}ID
     * @return 结果
     */
    @Override
    public ${className}Po info(Long ${pk.attrname}) {

        log.info("${className}FacadeImpl.info:入参：${pk.attrname}:{}", ${pk.attrname});
        ${className}Po ${classname} = ${classname}Mapper.selectByPrimaryKey(${pk.attrname});
        return ${classname};
    }

    /**
     * ${comments}详细信息
     *
     * @param ${pk.attrname} ${comments}ID
     * @return 结果
     */
    @Override
    public ${className}Po getById(Long ${pk.attrname}) {

        log.info("${className}FacadeImpl.getById:入参：${pk.attrname}:{}", ${pk.attrname});
        return ${classname}Mapper.selectByPrimaryKey(${pk.attrname});
    }

    /**
     * 保存${comments}信息
     *
     * @param ${classname}
     * @return 结果
     */
    @Override
    public void insert(${className}Po ${classname}, CurrAccountVo account) {

        log.info("${className}FacadeImpl.insert:入参：${classname}:{}", JSON.toJSON(${classname}));
        if (account != null) {
            Long createBy = account.getId();
            String createName = account.getName();
            ${classname}.setCreateBy(createBy);
            ${classname}.setCreateName(createName);
        }
        ${classname}Mapper.insertSelective(${classname});
    }

    /**
     * 修改${comments}信息
     *
     * @param ${classname}
     * @return 结果
     */
    @Override
    public void update(${className}Po ${classname}, CurrAccountVo account) {
        log.info("${className}FacadeImpl.update:入参：${classname}:{}", JSON.toJSON(${classname}));
        if (account != null) {
            Long createBy = account.getId();
            String createName = account.getName();
            ${classname}.setCreateBy(createBy);
            ${classname}.setCreateName(createName);
        }
        ${classname}Mapper.updateByPrimaryKeySelective(${classname});
    }

    /**
     * 删除${comments}信息
     *
     * @param ${pk.attrname} 需要删除的${comments}ID
     * @return 结果
     */
    @Override
    public void deleteById(Long ${pk.attrname}) {

        log.info("${className}FacadeImpl.deleteById:入参：${pk.attrname}:{}", ${pk.attrname});
        ${classname}Mapper.deleteByPrimaryKey(${pk.attrname});
    }

    /**
     * 批量新增 ${comments}
     *
     * @param ${classname}s 需要新增的数据
     * @return 结果
     */
    @Override
    public void batchInsert(List<${className}Po> ${classname}s) {
        if (ListUtil.isNotEmpty(${classname}s)) {
            ${classname}Mapper.batchInsert(${classname}s);
        }
    }
}
