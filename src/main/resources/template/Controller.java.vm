package ${package}.${moduleName}.controller;

import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import com.tool.common.web.WebBaseController;
import com.tool.common.web.BaseResult;
import com.tool.common.util.page.PageBean;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.tags.Tag;
import org.springframework.web.bind.annotation.*;
import javax.annotation.Resource;
import java.util.List;

import ${package}.${moduleName}.model.${className};
import ${package}.${moduleName}.service.${className}Service;

/**
 * ${comments}管理
 *
 * @author ${author}
 * @email ${email}
 * @date ${datetime}
 */
@RestController
@RequestMapping("/${pathName}")
@Tag(name = "${pathName}-controller", description = "${comments}管理")
public class ${className}Controller extends WebBaseController {

    @Resource
    private ${className}Service ${classname}Service;

    /**
     * ${comments}列表
     *
     * @return
     */
    @GetMapping("/page")
    @Operation(summary = "${comments}列表")
    public BaseResult<PageBean<${className}>> page() {

        startPage();
        List<${className}> ${classname} = ${classname}Service.list(
                new QueryWrapper<${className}>()
                        .eq("del_flag", 0));
        return BaseResult.success(new PageBean<${className}>(${classname}));
    }

    /**
     * ${comments}信息
     *
     * @param ${pk.attrname}
     * @return
     */
    @GetMapping("/{${pk.attrname}}")
    @Operation(summary = "${comments}信息")
    public BaseResult<${className}> info(@Parameter(description = "ID") @PathVariable Long ${pk.attrname}){

        ${className} ${classname} = ${classname}Service.getOne(
                new QueryWrapper<${className}>()
                        .eq("del_flag", 0)
                        .eq("${pk.columnName}", ${pk.attrname}));
        return BaseResult.success(${classname});
    }

    /**
     * 保存${comments}信息
     *
     * @param ${classname}
     * @return
     */
    @PostMapping
    @Operation(summary = "保存${comments}列表")
    public BaseResult save(@RequestBody ${className} ${classname}){

        ${classname}Service.save(${classname});
        return BaseResult.success();
    }

    /**
     * 修改${comments}信息
     *
     * @param ${classname}
     */
    @PutMapping
    @Operation(summary = "修改${comments}列表")
    public BaseResult update(@RequestBody ${className} ${classname}){

        ${classname}Service.updateById(${classname});
        return BaseResult.success();
    }

    /**
     * 删除${comments}信息
     * @param ${pk.attrname}s
     */
    @DeleteMapping
    @Operation(summary = "删除${comments}列表")
    public BaseResult delete(@RequestBody Long[] ${pk.attrname}s){

        ${classname}Service.deleteByIds(${pk.attrname}s);
        return BaseResult.success();
    }
}
