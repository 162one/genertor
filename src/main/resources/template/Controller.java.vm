package ${package}.${moduleName}.controller;

import io.swagger.annotations.Api;
import io.swagger.annotations.ApiImplicitParam;
import io.swagger.annotations.ApiImplicitParams;
import io.swagger.annotations.ApiOperation;
import com.hd.common.web.BaseResult;
import com.hd.common.web.WebBaseController;
import org.springframework.validation.annotation.Validated;
import com.hd.common.util.PageBean;
import com.hd.common.util.PageParam;

import ${package}.${moduleName}.model.po.${className};
import ${package}.${moduleName}.service.${className}Service;

/**
 * ${comments}管理
 *
 * &#064;author ${author}
 * &#064;email ${email}
 * &#064;date ${datetime}
 */
@RestController
@RequestMapping("/${pathName}")
@Api(tags = "${comments}管理")
public class ${className}Controller extends WebBaseController {

    @Resource
    private ${className}Service ${classname}Service;

    /**
     * ${comments}列表
     *
     * @param pageParam
     * @return
     */
    @PostMapping("/page")
    @ApiOperation("${comments}列表")
    public BaseResult<PageBean<${className}Po>> page(@RequestBody @Validated PageParam pageParam) {

        PageBean<${className}Po> ${classname} = ${classname}Service.page(pageParam);
        return BaseResult.success(${classname});
    }

    /**
     * ${comments}信息
     *
     * @param ${pk.attrname}
     * @return
     */
    @GetMapping("/{${pk.attrname}}")
    @ApiOperation("${comments}信息")
    public BaseResult<${className}Po> info(@ApiParam(name = "${pk.attrname}", value = "${comments}Id", required = true) @PathVariable Long ${pk.attrname}){

        ${className}Po ${classname} = ${classname}Service.info(${pk.attrname});
        return BaseResult.success(${classname});
    }

    /**
     * 保存${comments}信息
     *
     * @param ${classname}
     * @return
     */
    @PostMapping("/save")
    @ApiOperation("保存${comments}信息")
    public BaseResult save(@RequestBody @Validated ${className}Po ${classname}){

        ${classname}Service.insert(${classname}, getUser());
        return BaseResult.success();
    }

    /**
     * 修改${comments}信息
     */
    @PostMapping("/update")
    @ApiOperation("修改${comments}信息")
    public BaseResult update(@RequestBody @Validated ${className}Po ${classname}){

        ${classname}Service.update(${classname}, getUser());
        return BaseResult.success();
    }

    /**
     * 删除${comments}信息
     */
    @PostMapping("/delete/{${pk.attrname}}")
    @ApiOperation("删除${comments}信息")
    public BaseResult delete(@ApiParam(name = "${pk.attrname}", value = "${comments}Id", required = true) @PathVariable Long ${pk.attrname}){

        ${classname}Service.deleteById(${pk.attrname});
        return BaseResult.success();
    }
}
